{
  "name": "@moruteaven/email",
  "version": "0.1.0-dev.0",
  "description": "Type-safe, zero-dependency client SDK for the Teaven Email platform",
  "keywords": [
    "teaven",
    "email",
    "sdk",
    "transactional-email",
    "api-client"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://packages.aliyun.com/631c7575050e9c4a07a99328/npm/teaven-email-sdk/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoruTeaven/Teaven-Email-SDK.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/MoruTeaven/Teaven-Email-SDK#readme",
  "bugs": {
    "url": "https://github.com/MoruTeaven/Teaven-Email-SDK/issues"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
